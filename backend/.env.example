# Application
APP_NAME=NexaMind
# development | production. Anything other than development/test enforces production checks.
APP_ENV=development
# Returns exception details in API errors. Never enable in production.
DEBUG=false

# Database: SQLite for local development, PostgreSQL in production
# Render provides postgres:// URLs; the app rewrites them to postgresql+asyncpg:// automatically.
DATABASE_URL=sqlite+aiosqlite:///./nexamind.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexamind

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Encrypts users' saved Gemini keys at rest (defaults to a key derived from JWT_SECRET_KEY)
DATA_ENCRYPTION_KEY=

# Comma-separated frontend origins allowed to call the API
# Production (Render Static Site): https://nexamind-web.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# AI providers (optional). Users can also save their own Gemini key in Settings.
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
MAX_RECORDING_MB=200

# Optional: share real-time events across several API instances
REDIS_URL=

# Rate limits per client IP per minute
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

LOG_LEVEL=INFO
