# Application
APP_NAME=NexaMind
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL for production; SQLite supported for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexamind

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
