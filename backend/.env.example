# Application
APP_NAME=NexaMind
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL for production; SQLite supported for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexamind

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO

# Security & CORS (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8081

# AI Providers (optional, needed for meeting transcription, summaries, and agent features)
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
